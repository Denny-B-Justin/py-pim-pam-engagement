# ─────────────────────────────────────────────────────────────────────────────
# PIM-PAM engagement site — environment variables
#
# Local development : copy this file to `.env` (never commit it) and fill it in.
# Posit Connect     : do NOT upload a .env file. Add each variable in the content's
#                     "Vars" pane (Settings → Vars) instead; mark the secrets as such.
#
# Values containing `#` or spaces must be wrapped in quotes.
# ─────────────────────────────────────────────────────────────────────────────

# ── Databricks SQL warehouse (Azure Databricks, Unity Catalog) ───────────────
# Workspace host name — no https://, no trailing slash.
DATABRICKS_SERVER_HOSTNAME=adb-0000000000000000.0.azuredatabricks.net
# SQL warehouse → Connection details → HTTP path.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# Service principal used by the app (OAuth machine-to-machine).
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Only if the secret is an *Azure Entra ID* application secret rather than a Databricks-managed
# OAuth secret: the Entra tenant (directory) ID. Leave empty for a Databricks-managed secret.
DATABRICKS_AZURE_TENANT_ID=

# Where the tables live. The defaults are the ones in constants.py — override only if needed.
DATABRICKS_CATALOG=prd_mega
DATABRICKS_SCHEMA=sgpbpi163

# ── App access (staff pages) ─────────────────────────────────────────────────
# Shared password that unlocks /?page=admin and the other staff pages.
APP_PASSWORD=
# Secret that signs the session cookie — at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_COOKIE_SECRET=
# true when the app is served over HTTPS (always the case on Posit Connect).
SESSION_COOKIE_SECURE=false

# ── Optional ─────────────────────────────────────────────────────────────────
# Seconds the read-only pages cache database results (per worker process).
CACHE_TTL_SECONDS=300
# Public URL of the deployed content; used for link-preview (OpenGraph) tags. Empty = omitted.
SITE_URL=
# Local server only (python app.py). Posit Connect ignores HOST / PORT.
HOST=0.0.0.0
PORT=8050
DEBUG=false
LOG_LEVEL=INFO
